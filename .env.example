# iHRIS to DHIS2 HRH Mediator - Environment Configuration
# Sourced from dataElements.json (all HR levels: Facility, Woreda, Zone, Region)

# iHRIS v5
IHRIS_BASE_URL=https://ihris.example.org/fhir
IHRIS_USERNAME=admin@ihris.org
IHRIS_PASSWORD=yourpassword
IHRIS_TIMEOUT_MS=300000        # 5 minutes - increase if production server is slow
IHRIS_PAGE_SIZE=500            # records per offset page - lower if server times out

# DHIS2
DHIS2_BASE_URL=https://dhis2.example.org/api
DHIS2_USERNAME=admin
DHIS2_PASSWORD=yourpassword
DHIS2_ORG_UNIT_LEVEL=3            # Facility level in your org unit hierarchy
DHIS2_TASK_TIMEOUT_MS=3600000    # 60 min per async import task - datasets are submitted in parallel so large ones may queue behind smaller ones
DHIS2_COC_MALE=BdGxq4NBEPy       # Male category option combo UID
DHIS2_COC_FEMALE=jaGKXhI81gP     # Female category option combo UID

# Facility-type HR datasets - pushed to the dataset matching the org unit's facility type.
DHIS2_DATASET_BASIC_HP=JKOfZFr4R5m        # Basic Health Post       (HR_Facility_ DEs)
DHIS2_DATASET_COMP_HP=lqwZa8PXmKU         # Comprehensive HP        (HR_Facility_ DEs)
DHIS2_DATASET_HEALTH_CENTER=COwNnyyYSmp   # Health Center           (HR_Facility_ DEs)
DHIS2_DATASET_HOSPITAL=k4b76SeWTSo        # Hospital                (HR_Facility_ DEs)
DHIS2_DATASET_CLINIC=Dt7o9eU9F6s          # Clinic                  (HR_Facility_ DEs)

# Administrative-level HR datasets - practitioners assigned to admin units (not facilities)
DHIS2_DATASET_WOREDA=pFr7FEZlEKF          # Woreda level            (HR_Woreda_ DEs)
DHIS2_DATASET_ZONE=DmP9l7qdnUy            # Zone level              (HR_Zonal_ DEs)
DHIS2_DATASET_REGION=eaHbCxq65to          # Region level            (HR_Region_ DEs)

# Default period - annual (e.g. 2018 for Ethiopian Fiscal Year 2018).
DHIS2_PERIOD=2018

# OpenHIM
OPENHIM_URL=https://openhim-core:8080   # Use container name when mediator runs in Docker; use https://localhost:8080 for npm start
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=yourpassword
MEDIATOR_PORT=3000
MEDIATOR_HOST=ihris-dhis2-mediator     # Container name used in OpenHIM channel route (must match docker-compose service name)
REGISTER_MEDIATOR=true

# Scheduler
CRON_ENABLED=true
CRON_SCHEDULE=0 2 1 1 *           # First day of January at 2am (annual)

# Demo / Testing
# Limit roles fetched per stream for fast demos. Remove or set to 0 for production.
# IHRIS_MAX_ROLES=200


# DHIS2 DATA ELEMENT UIDs  (sourced from dataElements.json)
#
# Naming convention: DE_{CADRE}_{STATUS}
# STATUS values:
#    BEGINNING   = headcount at beginning of year    -> maps to UC-P2-02 active
#    END_OF_YEAR = headcount at end of year           -> maps to UC-P2-02 active
#    LEAVING     = left during reporting period       -> maps to UC-P2-03 attrition
#    RECRUITED   = hired during reporting period      -> maps to UC-P2-04 recruited
#    LICENSED    = active/renewed professional licence (informational)
#    STANDARD    = facility staffing norm/target      (informational)
#
# CADRE groups (as defined in DHIS2 HR_Facility dataset):
#    MIDWIVES | NURSES | PHYSICIANS | HEALTH_OFFICERS |
#    OTHER_HEALTH | HEALTH_EXTENSION | ESOS


# Midwives
DE_MIDWIVES_BEGINNING=oEZPfIU9G0L    # HR_Facility_ Midwives at beginning of the year
DE_MIDWIVES_END_OF_YEAR=IW5qpYBP1Bu  # HR_Facility_Midwives at end of the year
DE_MIDWIVES_LEAVING=S2exw6vVwCU      # HR_Facility _ Midwives leaving during the year
DE_MIDWIVES_RECRUITED=PbDlZPOl77B    # HR_Facility_Midwives recruited during year
DE_MIDWIVES_LICENSED=NogurPbgUIp     # HR_Facility_ Midwives with active/renewed Liscence
DE_MIDWIVES_STANDARD=ZnouLXsZ53A     # HR_Facility_Facility Standard: Midwives

# Nurses
DE_NURSES_BEGINNING=t2etNeB80Sb      # HR_Facility _ Nurses at beginning of the year
