DE_NURSES_LEAVING=V0dCo4gqVq4        # HR_Facility_Nurses leaving during the year
DE_NURSES_RECRUITED=USt9mbvrtma      # HR_Facility_Nurses recruited during year
DE_NURSES_LICENSED=Jq2LcTfg3uV       # HR_Facility_ Nurses with active/renewed Liscence
DE_NURSES_STANDARD=A4eM84u4kFr       # HR_Facility_Facility Standard: Nurses

