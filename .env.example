# ════════════════════════════════════════════════════════════════════════════
#  iHRIS → DHIS2 HRH Mediator — Environment Configuration
#  Generated from dataElements.json (HR_Facility level elements)
# ════════════════════════════════════════════════════════════════════════════

# ─── iHRIS v5 ───────────────────────────────────────────────────────────────
IHRIS_BASE_URL=https://ihris.example.org/fhir
IHRIS_USERNAME=admin
IHRIS_PASSWORD=yourpassword

# ─── DHIS2 ──────────────────────────────────────────────────────────────────
DHIS2_BASE_URL=https://dhis2.example.org/api
DHIS2_USERNAME=admin
DHIS2_PASSWORD=yourpassword
DHIS2_ORG_UNIT_LEVEL=3            # Facility level in your org unit hierarchy
DHIS2_COC_MALE=BdGxq4NBEPy       # Male category option combo UID (auto-discovered if omitted)
DHIS2_COC_FEMALE=jaGKXhI81gP     # Female category option combo UID (auto-discovered if omitted)

# Three DHIS2 dataset UIDs — one per use case (get from DHIS2 Maintenance > Datasets)
DHIS2_DATASET_ACTIVE=REPLACE_WITH_ACTIVE_DATASET_UID      # UC-P2-02 Active workforce
DHIS2_DATASET_ATTRITION=REPLACE_WITH_ATTRITION_DATASET_UID  # UC-P2-03 Left institution
DHIS2_DATASET_RECRUITED=REPLACE_WITH_RECRUITED_DATASET_UID  # UC-P2-04 Recruited

# Default period — quarterly per UC-P2-01 (e.g. 2024Q1, 2024Q2, 202401, 2024)
DHIS2_PERIOD=2024Q1

# ─── OpenHIM ─────────────────────────────────────────────────────────────────
OPENHIM_URL=https://openhim-core:8080
OPENHIM_USERNAME=root@openhim.org
OPENHIM_PASSWORD=openhim-password
MEDIATOR_PORT=3000
REGISTER_MEDIATOR=true

# ─── Scheduler ───────────────────────────────────────────────────────────────
CRON_ENABLED=true
CRON_SCHEDULE=0 2 1 1,4,7,10 *   # First day of each quarter at 2am

# ─── Demo / Testing ──────────────────────────────────────────────────────────
# Limit roles fetched per stream (active + inactive) for fast demos.
# Remove or set to 0 for full production sync.
# IHRIS_MAX_ROLES=200


# ════════════════════════════════════════════════════════════════════════════
#  DHIS2 DATA ELEMENT UIDs  (sourced from dataElements.json)
#
#  Naming convention: DE_{CADRE}_{STATUS}
#  STATUS values:
#    BEGINNING   = headcount at beginning of year    → maps to UC-P2-02 active
#    END_OF_YEAR = headcount at end of year           → maps to UC-P2-02 active
#    LEAVING     = left during reporting period       → maps to UC-P2-03 attrition
#    RECRUITED   = hired during reporting period      → maps to UC-P2-04 recruited
#    LICENSED    = active/renewed professional licence (informational)
#    STANDARD    = facility staffing norm/target      (informational)
#
#  CADRE groups (as defined in DHIS2 HR_Facility dataset):
#    MIDWIVES | NURSES | PHYSICIANS | HEALTH_OFFICERS |
#    OTHER_HEALTH | HEALTH_EXTENSION | ESOS
# ════════════════════════════════════════════════════════════════════════════


# ── Midwives ─────────────────────────────────────────────────────────────────
DE_MIDWIVES_BEGINNING=oEZPfIU9G0L    # HR_Facility_ Midwives at beginning of the year
DE_MIDWIVES_END_OF_YEAR=IW5qpYBP1Bu  # HR_Facility_Midwives at end of the year
DE_MIDWIVES_LEAVING=S2exw6vVwCU      # HR_Facility _ Midwives leaving during the year
DE_MIDWIVES_RECRUITED=PbDlZPOl77B    # HR_Facility_Midwives recruited during year
DE_MIDWIVES_LICENSED=NogurPbgUIp     # HR_Facility_ Midwives with active/renewed Liscence
DE_MIDWIVES_STANDARD=ZnouLXsZ53A     # HR_Facility_Facility Standard: Midwives

# ── Nurses ───────────────────────────────────────────────────────────────────
DE_NURSES_BEGINNING=t2etNeB80Sb      # HR_Facility _ Nurses at beginning of the year
DE_NURSES_END_OF_YEAR=Q9wcICaOgqP    # HR_Facility_ Nurses at end of the year
DE_NURSES_LEAVING=V0dCo4gqVq4        # HR_Facility_Nurses leaving during the year
DE_NURSES_RECRUITED=USt9mbvrtma      # HR_Facility_Nurses recruited during year
DE_NURSES_LICENSED=Jq2LcTfg3uV       # HR_Facility_ Nurses with active/renewed Liscence
DE_NURSES_STANDARD=A4eM84u4kFr       # HR_Facility_Facility Standard: Nurses

# ── Physicians ───────────────────────────────────────────────────────────────
DE_PHYSICIANS_BEGINNING=M6IWVDZpIcj  # HR_Facility_ Physicians at beginning of year
DE_PHYSICIANS_END_OF_YEAR=AcCvtaVuAxo  # HR_Facility_Physicians at end of the year
DE_PHYSICIANS_LEAVING=x5PxAwM0NKi    # HR_Facility _ Physicians leaving during the year
DE_PHYSICIANS_RECRUITED=dLyiNI4eHdk  # HR_Facility _Physician recruited during year
DE_PHYSICIANS_LICENSED=GQXZpL6iFvz   # HR_Facility_ Physician with active/renewed License
DE_PHYSICIANS_STANDARD=zgouqDihEXA   # HR_Facility_Facility Standard: Physicians

# ── Health Officers ──────────────────────────────────────────────────────────
DE_HEALTH_OFFICERS_BEGINNING=qtQBy1Kzk6Y   # HR_Facility_Health Officers at beginning of year
DE_HEALTH_OFFICERS_END_OF_YEAR=juIYKqm2Ovt # HR_Facility_Health Officers at end of the year
DE_HEALTH_OFFICERS_LEAVING=pZEORWNDQdU     # HR_Facility_Health Officers leaving during the year
DE_HEALTH_OFFICERS_RECRUITED=KZQz2IxvxY2  # HR_Facility - Health Officers recruited during the year
DE_HEALTH_OFFICERS_LICENSED=m8TG60bPgyn   # HR_Facility_Health Officers with active/renewed Liscence
DE_HEALTH_OFFICERS_STANDARD=vFu4CoFgwzH   # HR_Facility_Facility Standard: Health Officers

# ── Other Health Professionals ───────────────────────────────────────────────
DE_OTHER_HEALTH_BEGINNING=kQnAzpGLBl0     # HR_Facility_Other Health Professionals at beginning of year
DE_OTHER_HEALTH_END_OF_YEAR=QyRuKKZUUis   # HR_Facility_Other Health Professionals at end of the year
DE_OTHER_HEALTH_LEAVING=X4TxuDq7Osa       # HR_Facility _Other Health Professionals leaving during the year
DE_OTHER_HEALTH_RECRUITED=ponJzNFgewX     # HR_Facility_Other Health Professionals recruited during year
DE_OTHER_HEALTH_LICENSED=bW53yUcMliR      # HR_Facility_ Other Health Professionals with active/renewed Liscence
DE_OTHER_HEALTH_STANDARD=aO8Du0lgPxV      # HR_Facility_Facility Standard: Other Health Professionals

# ── Level IV Health Extension Workers ────────────────────────────────────────
DE_HEALTH_EXTENSION_BEGINNING=r1Bq2zvXcAD  # HR_Facility_Level IV Health extension workers at beginning of year
DE_HEALTH_EXTENSION_END_OF_YEAR=nrWOSRcAer5 # HR_Facility_Level IV Health extension workers at end of year
DE_HEALTH_EXTENSION_LEAVING=bIApnog7HU7    # HR_Facility_Level IV Health extension workers leaving during the year
DE_HEALTH_EXTENSION_RECRUITED=ifZN8J6zfe1  # HR_Facility_Staff recruited during year: Level IV Health extension workers
DE_HEALTH_EXTENSION_LICENSED=B6e625wiKJR   # HR_Facility_ Level IV Health extension workers with active/renewed Liscence
DE_HEALTH_EXTENSION_STANDARD=NcIuLI1Zo8F  # HR_Facility_Facility Standard: Level IV Health extension workers

# ── ESOs (Emergency Surgical Officers) ──────────────────────────────────────
DE_ESOS_BEGINNING=bwYGUpiYYTE        # HR_Facility_ ESOs (Emergency surgical Officers) at beginning of year
DE_ESOS_END_OF_YEAR=POobr58Dpqw      # HR_Facility_ESOs (Emergency surgical Officers) at end of the year
DE_ESOS_LEAVING=kEuX4jB52qy          # HR_Facility_ESOs (Emergency surgical Officers) leaving during the year
DE_ESOS_RECRUITED=tNwIImYY3DJ        # HR_Facility_ESOs (Emergency surgical Officers) recruited during year
DE_ESOS_LICENSED=PFkD9fSrDvh         # HR_Facility_ESOs (Emergency surgical Officers) with active/renewed Liscence
DE_ESOS_STANDARD=HrDCW0YapFz         # HR_Facility_Facility Standard: ESOs (Emergency surgical Officers)


# ════════════════════════════════════════════════════════════════════════════
#  CADRE MAPPING NOTE FOR hrh.transform.js
#
#  The DHIS2 HR_Facility dataset groups iHRIS cadres as follows:
#
#  DE_MIDWIVES_*        ← Midwifery (all categories)
#  DE_NURSES_*          ← Nursing (all categories)
#  DE_PHYSICIANS_*      ← Medical Doctor, General Practitioner
#  DE_HEALTH_OFFICERS_* ← Health Officer (HO)
#  DE_HEALTH_EXTENSION_*← Health Extension / Family Health Workers (Level IV)
#  DE_ESOS_*            ← Emergency Surgical Officers
#  DE_OTHER_HEALTH_*    ← All remaining cadres:
#                          Anesthesia, Radiology, Ophthalmology, Pharmacy,
#                          Lab, Dental, Biomedical, Health IT, Mental Health,
#                          Public Health, Environmental Health, Specialist,
#                          MPH, MSc, Physiotherapy, Prosthetics, Admin, etc.
#
#  Note: This DHIS2 dataset does NOT disaggregate by gender at facility level.
#  Gender disaggregation may be available through category option combos (COCs)
#  on the same data elements — check your DHIS2 dataset configuration.
# ════════════════════════════════════════════════════════════════════════════
IHRIS_MAX_ROLES=500  # Limit roles fetched per stream (active + inactive) for fast demos.